  - killer moves 
  @code cpp
  namespace AlphaBeta {

  using EvalFunction = int (*) (const chessBoard&, bool, bool);
  template <EvalFunction eval>
  searchAnswer alphaBeta(searchState st, chessBoard board, int depthleft) {
      bool isWhiteTurn = board.m_board_state & board_state::WhiteTurn;
      bool endgame = false;
      searchAnswer bestMove {-1000000000};
      auto allMoves = chessMoves::makeAllMoves(board);

      if (depthleft == 0 || allMoves.numitems() == 0)
          return searchAnswer{eval(board, isWhiteTurn, endgame)}; // TODO : change this to quiessence search

      for (const auto& mv : allMoves) {
          chessBoard newBoard = board.applyMovePure(mv);
          searchAnswer possibleAnswer = alphaBeta<eval>(st.reflectPure(), newBoard, depthleft-1).negate();

          if (possibleAnswer.evalScore > bestMove.evalScore) {
              bestMove.evalScore = possibleAnswer.evalScore;
              bestMove.move = mv;
          }

          // if the best move for the node is better than the worst that the opponent can do 
          // then the move is good enough for the other player to choose a different line 

          // therefore in this specific position playing this specific move is very good 
          // therefore we should note down agains the node hash that this move is a killer move? 
          if (possibleAnswer.evalScore >= st.beta) {
              break;
          }

          // 
          st.alpha = std::max(st.alpha, possibleAnswer.evalScore);
      }

      return bestMove;
  }
  
  @end
    
